{
  "_说明": "三种 MCP 客户端的通用接线模板。请把 <插件目录> 替换为本仓库在本机的绝对路径，把 <你的 token> 替换为网关状态文件里的 token；command 可用本机任一 Node.js 22.19+ 可执行文件。",
  "cursor": {
    "path": "<用户目录>/.cursor/mcp.json",
    "server": {
      "command": "node",
      "args": [
        "<插件目录>/lib/mcp-server.js"
      ],
      "env": {
        "DSMG_TOKEN": "<你的 token>",
        "DSMG_PORT": "8890",
        "DSMG_HOST": "127.0.0.1"
      }
    }
  },
  "codebuddy": {
    "path": "<用户目录>/.codebuddy/mcp.json",
    "server": {
      "command": "node",
      "args": [
        "<插件目录>/lib/mcp-server.js"
      ],
      "env": {
        "DSMG_TOKEN": "<你的 token>",
        "DSMG_PORT": "8890",
        "DSMG_HOST": "127.0.0.1"
      }
    }
  },
  "workbuddy": {
    "path": "<用户目录>/.workbuddy/mcp.json",
    "server": {
      "command": "node",
      "args": [
        "<插件目录>/lib/mcp-server.js"
      ],
      "env": {
        "DSMG_TOKEN": "<你的 token>",
        "DSMG_PORT": "8890",
        "DSMG_HOST": "127.0.0.1"
      }
    }
  }
}
